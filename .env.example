# Optional: default Plusvibe API key used server-side when a request does not
# supply one via the UI. The key grants access to ALL workspaces under the
# Plusvibe account, so treat it as a secret. Leave unset to require users to
# enter their key in the app (stored only in their browser).
#
# Get a key at https://app.plusvibe.ai/v2/settings/api-access/ (Business plan).
PLUSVIBE_API_KEY=

# Optional: directory where the "Remove Inboxes" tool stores background-job
# records (JSON, one file per job; the API key is never written). Defaults to
# ./.jobs. On Railway, point this at a mounted volume (e.g. /data/jobs) so job
# history survives redeploys — otherwise records last only for the container's
# lifetime (they still survive closing the browser).
JOBS_DIR=
